# Copy to backend/.env and fill in. Never commit real values.
DATABASE_URL=postgresql+psycopg://growthos:CHANGE_ME@localhost:5432/growthos
# Fallback without Postgres:
# DATABASE_URL=sqlite:///./growthos.db
AI_PROVIDER=none
CORS_ORIGINS=http://localhost:3000
# Weekly source refresh (Mon 05:00 UTC) + refresh on startup
SCHEDULER_ENABLED=true

# Sources: comma-separated ids (curated, devpost, kaggle)
SOURCES_ENABLED=curated,devpost,kaggle
# Kaggle API token (kaggle.com -> Settings -> API -> Create New Token)
KAGGLE_USERNAME=
KAGGLE_KEY=
# OpenAI-compatible LLM gateway for fact extraction (OmniRoute). Empty = extraction disabled.
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=
LLM_MODEL=auto/fast
