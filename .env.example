# Copy to backend/.env and fill in. Never commit real values.
DATABASE_URL=postgresql+psycopg://growthos:CHANGE_ME@localhost:5432/growthos
# Fallback without Postgres:
# DATABASE_URL=sqlite:///./growthos.db
AI_PROVIDER=none
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Weekly source refresh (Mon 05:00 UTC) + refresh on startup
SCHEDULER_ENABLED=true

# Sources: comma-separated ids (curated, devpost, kaggle, gmail)
SOURCES_ENABLED=curated,devpost,kaggle,gmail
# Kaggle API token (kaggle.com -> Settings -> API -> Create New Token)
KAGGLE_USERNAME=
KAGGLE_KEY=
# OpenAI-compatible LLM gateway for fact extraction (OmniRoute). Empty = extraction disabled.
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=
LLM_MODEL=auto/fast

# Dedicated growthOS Google Calendar (optional; create a Web OAuth client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/calendar/callback
FRONTEND_URL=http://localhost:3000

# Read-only Gmail source (optional; same OAuth client, register this redirect URI too).
# Only messages with GMAIL_LABEL are read, and their text goes to the LLM above (ADR 0009).
GOOGLE_GMAIL_REDIRECT_URI=http://127.0.0.1:8000/gmail/callback
GMAIL_LABEL=growthOS
GMAIL_MAX_MESSAGES=50
