{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "backend",
        "python",
        "-m",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 3000
    },
    {
      "name": "backend-8001",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--directory",
        "backend",
        "python",
        "-m",
        "uvicorn",
        "app.main:app",
        "--port",
        "8001"
      ],
      "port": 8001,
      "env": {
        "CORS_ORIGINS": "http://localhost:3001,http://127.0.0.1:3001",
        "FRONTEND_URL": "http://localhost:3001"
      }
    },
    {
      "name": "frontend-api-8001",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend",
        "--",
        "--port",
        "3001"
      ],
      "env": {
        "NEXT_PUBLIC_API_URL": "http://127.0.0.1:8001",
        "API_URL": "http://127.0.0.1:8001"
      },
      "port": 3001
    }
  ]
}
